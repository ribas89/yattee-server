# Yattee Server Configuration
# Copy this file to .env and adjust values as needed
#
# NOTE: Most runtime settings (cache TTLs, Invidious, yt-dlp, feed settings)
# are now configured via the admin panel. Only startup settings are here.

# Server settings
HOST=0.0.0.0
PORT=8085

# Data directory (for database, encryption keys, etc.)
DATA_DIR=/data

# Download directory (for proxied video downloads, empty = default)
# DOWNLOAD_DIR=

# Size of each upstream /proxy/relay HTTP range request, in bytes.
# Default 1048576 (1 MiB); accepted range: 65536-10485760 bytes.
# Change this in your .env (not in Python code), then recreate the container.
HTTP_CHUNK_SIZE=1048576

# Prefer progressive muxed video+audio (e.g., itag 18 at 360p) whenever present.
# Suppresses adaptive video-only choices while preserving audio-only playback.
# Set false to restore separate DASH video+audio format choices (including >360p).
PREFER_COMBINED_STREAMS=true

# Persistent combined media cache: complete files AND sparse partial byte ranges.
# On startup, remove complete/partial entries last accessed over VIDEO_CACHE_DAYS
# days ago. Partial ranges can be replayed immediately and missing spans are
# fetched on demand. Files under /data survive container rebuilds.
# Set VIDEO_CACHE_DAYS=0 to disable caching.
VIDEO_CACHE_DAYS=30
VIDEO_CACHE_DIR=/data/cache/videos

# Persistent metadata: descriptions never expire, comments have a configurable TTL.
# Keep these on the /data volume so container restarts retain the cache.
COMMENTS_CACHE_MINUTES=360
VIDEO_DESCRIPTION_CACHE_DIR=/data/cache/video_descriptions
COMMENTS_CACHE_DIR=/data/cache/comments

# Optional: Pre-set encryption key for credentials (auto-generated if not set)
# CREDENTIALS_ENCRYPTION_KEY=your-fernet-key-here

# CORS Configuration
# By default, CORS is disabled (no cross-origin requests allowed).
#
# For production: Set specific allowed origins (comma-separated)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
#
# For development: Allow all origins (credentials will be DISABLED)
# CORS_ALLOW_ALL=true
#
# Control credentials (cookies, auth headers) - only works with specific origins
# CORS_ALLOW_CREDENTIALS=true

# Security
# DEBUG=false              # Enable auto-reload in development
# SECURE_COOKIES=true      # Enforce HTTPS-only cookies; set false for local dev without HTTPS
# YTDLP_SKIP_TLS_VERIFY=false  # Skip TLS verification in yt-dlp (not recommended for production)

# Network
# HTTP/SOCKS proxy for YouTube-bound traffic (yt-dlp, InnerTube, Invidious fallback).
# Sets the startup default; can be overridden at runtime in the admin panel.
# YT_EGRESS_PROXY=http://user:pass@host:port
# YT_EGRESS_PROXY=socks5://host:port
#
# Force IP family for YouTube-bound egress: auto, ipv4 or ipv6.
# Sets the startup default; can be overridden at runtime in the admin panel.
# YT_IP_FAMILY=auto
#
# PO token provider (bgutil) — unblocks full formats on age-restricted videos.
# Sets the startup defaults; can be overridden at runtime in the admin panel.
# YT_POT_ENABLED=true
# External provider base URL; leave unset to use the provider bundled in the
# Docker image (managed by the app).
# YT_POT_PROVIDER_URL=http://host:4416
#
# Additional CIDR ranges to permit through the SSRF guard (comma-separated, IPv4/IPv6).
# Useful when a backing service lives on the LAN and returns stream URLs with private IPs.
# Loopback is always blocked regardless.
# SSRF_EXTRA_ALLOWED_CIDRS=10.20.30.0/24,fd00::/8

# Auto-provisioning (optional, for automated deployments)
# When both ADMIN_USERNAME and ADMIN_PASSWORD are set, an admin user is auto-created/updated on startup
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# When set, configures the Invidious instance URL and enables the proxy on startup
# INVIDIOUS_INSTANCE_URL=

# Persistent lazy avatar cache; only refreshes when a channel is opened.
# With a bind-mount like "/mnt/hd1/docker/yattee/data:/data", use:
AVATAR_REFRESH_DAYS=14
AVATAR_CACHE_DIR=/data/cache/avatars
# Delay initial background feed sweep to avoid a burst at startup.
FEED_STARTUP_DELAY_SECONDS=300
# Per-channel, persistent successful feed refresh interval (minutes)
FEED_REFRESH_MINUTES=360
